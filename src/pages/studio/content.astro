---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentLibrary from '../../components/ContentLibrary';
---

<BaseLayout title="Content — XStudio" description="Manage drafts, reviews, schedules, publications, series, tags, and analytics in XStudio.">
  <main class="studio-layout library-layout">
    <aside class="studio-sidebar">
      <a class="brand studio-brand" href="/"><span class="brand-mark">X</span><span>Studio</span></a>
      <button class="workspace-switcher"><span class="workspace-icon">A</span><span><small>WORKSPACE</small>Acme Engineering</span><b>⌄</b></button>
      <nav aria-label="Studio"><a class="active" href="/studio/content"><span>✦</span> Content</a><a href="/studio/"><span>＋</span> Editor</a><a href="#"><span>⌕</span> Search</a><a href="#"><span>⌁</span> Git sync</a><a href="#"><span>↗</span> Publishing</a></nav>
      <div class="sidebar-heading"><span>COLLECTIONS</span><button>+</button></div>
      <nav class="collections"><a class="active"><span>▤</span> Engineering blog</a><a><span>▤</span> Product docs</a><a><span>▤</span> Architecture</a></nav>
      <div class="sidebar-bottom"><a>⚙ Settings</a><div class="user-row"><span class="avatar">AP</span><span><b>Abhishek Panda</b><small>Owner</small></span><b>•••</b></div></div>
    </aside>
    <section class="studio-main">
      <header class="studio-topbar"><div class="breadcrumbs"><span>Engineering blog</span><b>/</b><span>Content</span></div><div class="top-actions"><span class="branch-state">⌁ main</span><button>Customize publication</button><span class="more">•••</span></div></header>
      <ContentLibrary client:load />
    </section>
  </main>
</BaseLayout>

